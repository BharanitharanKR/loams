# Pinned Buck2 tooling for Loams' Rust build (loams-build step 1).
#
# The canonical copy of these pins is `pins/buck2.env` on the `loams/main`
# branch of ostrium-labs/loams-build; keep the pinned values identical. A bump changes
# every line of a tool at once and is its own pull request.
#
# Buck2: an upstream facebook/buck2 release, never a build of our own. The
# prelude is the one bundled in that binary (`[external_cells] prelude =
# bundled`), so the release pins it too; BUCK2_PRELUDE_HASH records which
# facebook/buck2-prelude commit that is (the release's `prelude_hash` asset).
# MIT OR Apache-2.0.
BUCK2_VERSION=2026-10-01
BUCK2_COMMIT=2484d70a6f8a5b1f26cbdfdbd7758c9c5b746f49
BUCK2_PRELUDE_HASH=87765b7b4ff7762535c5c1529f8d2af871e53b12
# sha256 of the release's `buck2-<triple>.zst` assets.
BUCK2_SHA256_x86_64_unknown_linux_gnu=828aba01bf80e8ba50ed27d89be86efe0246b3807c3d040e1ea7b4810a55fb78
BUCK2_SHA256_aarch64_unknown_linux_gnu=8df3e94f569b1df74c905e26d18ea6bf6e64f946d0f0cbec90c7398bd33d1861
BUCK2_SHA256_aarch64_apple_darwin=cf670f779c2a8a50d1ee27ecedd8b6adc008833febf174c616a6a5cf057f5673
BUCK2_SHA256_x86_64_apple_darwin=f01718efb66c83ca21126af39083aa2506a27b35f93714aa7534e9613571ac9d

# Reindeer: facebookincubator/reindeer has no releases or crates.io package,
# so it is built with `cargo install --locked` at this commit (2026-10-01, the
# day of the Buck2 release above). MIT OR Apache-2.0.
REINDEER_GIT=https://github.com/facebookincubator/reindeer
REINDEER_REV=b58b3326e261eefe32f2295bbbed89cee7a3c539
