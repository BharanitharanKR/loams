<?xml version="1.0" encoding="UTF-8"?>
<!--
  Loams Desktop (Electron) Windows artifact configuration for SignPath, UNPACKED APP (AP1e Task 31, D677).

  Paste this into SignPath as an artifact configuration of the project and set the repository
  variable SIGNPATH_DESKTOP_WINDOWS_ARTIFACT_CONFIGURATION_SLUG to its slug. The NSIS installer has
  its own configuration, artifact-configuration.desktop-windows-installer.xml. docs/release/desktop.md
  has the whole setup.

  The submission is a ZIP of dist/win-unpacked, sent BEFORE the installer is built so the installer
  packages signed executables. "Loams Desktop.exe" is required (min-matches defaults to 1, so a
  ZIP without it fails). resources/bin/loams.exe, the bundled engine, is optional because the Windows
  build ships without it when it does not build. The Electron DLLs and any .node files are signed
  when present.

  The certificate and signing policy are set SignPath-side (SIGNPATH_WINDOWS_SIGNING_POLICY_SLUG) and
  must be an Authenticode certificate, not the GPG key the rpm policy uses. The workflow then
  checks every signature with Get-AuthenticodeSignature; it does not trust the submission.

  The product-name restriction is the SignPath Foundation requirement (docs/release/signing.md).
  UNVERIFIED: the `product-name` attribute spelling follows SignPath's file-metadata-restrictions
  reference; if SignPath rejects the pasted configuration, check that first.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Loams Desktop.exe" product-name="Loams Desktop">
      <authenticode-sign />
    </pe-file>
    <pe-file-set>
      <include path="**/*.dll" min-matches="0" />
      <include path="**/*.node" min-matches="0" />
      <include path="resources/bin/loams.exe" min-matches="0" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
