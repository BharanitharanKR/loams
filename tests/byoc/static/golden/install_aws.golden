# .env (keys that --cloud sets)
LOAMS_VERSION=0.1.1
LOAMS_BUCKET=s3://my-bkt/loams
COMPOSE_PROFILES=
TS_AUTHKEY=<from secret store>
LOAMS_SETUP_TOKEN=<from secret store>
# secrets/engine.env
AWS_REGION=us-east-1
# secrets: loams/loams (tailnet-authkey, setup-token, api-keys optional) in the aws secret store
