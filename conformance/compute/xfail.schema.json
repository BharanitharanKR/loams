{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ostrium-labs/loams/conformance/compute/xfail.schema.json",
  "title": "conformance/compute/<product>/xfail.toml",
  "description": "The expected failures of one product's conformance run (OC1 OC0 Task 1). scripts/compute/xfail_check.py applies it strictly: an unlisted failure fails the run, and so does a listed test that passed or that did not run.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "product": { "type": "string", "description": "The product directory's name." },
    "xfail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tests", "reason", "issue", "since"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Test names (`classname::name` or `name`) or fnmatch globs; every matched test must fail."
          },
          "reason": { "type": "string", "minLength": 8, "description": "Why it fails, e.g. \"needs Kafka\"." },
          "issue": {
            "type": "string",
            "pattern": "^(#[0-9]+|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+|https://github\\.com/[^/\\s]+/[^/\\s]+/(issues|pull)/[0-9]+)$"
          },
          "since": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
