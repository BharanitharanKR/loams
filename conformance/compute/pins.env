# Pins for the compute conformance harness (design 68 §12, design 74 §14;
# OC1 OC0 Task 1, DX1 DX0 Task 1). Every image by digest, every package by
# exact version, each at a release at least 14 days old when its PR opened
# (D1274; security fixes excepted). Read by conformance/compute/lib.sh, by
# deploy/release/compose.compute.yaml (through --env-file) and by the
# workflow. The licence of each pin is in licences.toml next to this file;
# scripts/compute/licence_gate.sh fails when a pin has no entry there, when
# an entry was made for another value, or when a licence is refused (D1271).
# Values are literal: no quotes, no variables, no spaces.

# --- Temporal (MIT), DX1 rulings R0.2-R0.5, checked 2026-10-23 -------------
TEMPORAL_VERSION=1.32.1
TEMPORAL_SERVER_IMAGE=docker.io/temporalio/server:1.32.1@sha256:acecbab5b0b8ae9cf4012b508866ca97feda3709577bf157b537239f40029049
TEMPORAL_ADMIN_TOOLS_IMAGE=docker.io/temporalio/admin-tools:1.32.1@sha256:9ef0dc5b063bf4ffd5c1512de72e0e73e225bd2c7006a18ce69bd592a8862a83
# The server's source at the tag, for the persistence suite (R0.5).
TEMPORAL_SERVER_COMMIT=af08a5e5f2dd40f545f2afac7780daaa6987001e
TEMPORAL_CLI=1.9.1
TEMPORAL_SDK_GO=1.49.0
TEMPORAL_SDK_TS=1.24.0
TEMPORAL_SAMPLES_GO=d3784428122e0cd4b28e91a0cd86b589749abf28
TEMPORAL_SAMPLES_TS=07a4b3a991ef0b17eed46ecf92a774169297e345
TEMPORAL_OMES=dae0843208ef65fd2f357145c00c770be7934331
# The server's go.mod says go 1.26.8; the corpus workers use the same image.
GO_IMAGE=docker.io/library/golang:1.26.8@sha256:eb36c1664dd974cde625f736e02c204383deebe03977365caaec5bf49f794348

# --- DBOS Transact (MIT), R0.10 ---------------------------------------------
DBOS_PY=3.2.0
DBOS_PY_COMMIT=d324156616281d7d4923bc60851617bdbb70ea5e
# npm @dbos-inc/dbos-sdk 5.2.11 is the release of repository tag v5.2.
DBOS_TS=5.2.11
