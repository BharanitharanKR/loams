DBOS_TS_COMMIT=3f36908f58fd8b3079cbf5372203c7a2d0ba06cc
DBOS_GO=1.6.0
DBOS_GO_COMMIT=04337c15667adcdf5cc057be448ed9545d6f06d9
DBOS_JAVA=1.2.0
DBOS_JAVA_COMMIT=0f4fe187b20bd6f5f735d8f99d810aeb90b8314d
# The runners' toolchains.
PYTHON_IMAGE=docker.io/library/python:3.12.14-bookworm@sha256:dbbe4ceb97851e2e5fa83798b239811f871cb743b259ba3563737349f6bcfaa0
NODE_IMAGE=docker.io/library/node:22.23.2-bookworm@sha256:dd5847a04b0deee391fa145f1f4c6d214196668b6bcc7988ebed67249f226844
JAVA_IMAGE=docker.io/library/eclipse-temurin:21.0.12_8-jdk-noble@sha256:4d271cd5e0624598cf563342f47281b09cb364bc13acbbd7251f49f83470018d

# --- Apache Airflow (Apache-2.0), R0.14 -------------------------------------
AIRFLOW_VERSION=3.3.2
AIRFLOW_IMAGE=docker.io/apache/airflow:3.3.2-python3.12@sha256:9df9c8be4096b9cc626bd7cb1f2b8c712eef66c59c615f8c7e6200871ca10bd1
AIRFLOW_CONSTRAINTS=https://raw.githubusercontent.com/apache/airflow/constraints-3.3.2/constraints-3.12.txt
AIRFLOW_TASK_SDK=1.3.2
AIRFLOW_EDGE3=4.3.2

# --- Tools --------------------------------------------------------------------
# psql for the harness's checks (the client only; the server is Loams Postgres).
PSQL_IMAGE=docker.io/library/postgres:17.10@sha256:7958605b474b3d264a969cb3a123d6aa00ad1e1fe9da8a69984dabb704d93317
# The DBOS runners reach Postgres on localhost:5432 through it (R0.12).
SOCAT_IMAGE=docker.io/alpine/socat:1.8.1.1@sha256:7f9a06753033f2b7de18edc2353f2c15153413d95a039163c6db270fc7a6c3b0
# The transaction-mode legs only (R0.8; conformance/compute/pgdog-txn.yaml,
# never distributed). AGPL-3.0, run unmodified as a separate process (D318).
PGDOG_IMAGE=ghcr.io/pgdogdev/pgdog@sha256:25d1908886f595a2e3b00ec59783326712e3c0f75f91d29f032ff712b30f2266
