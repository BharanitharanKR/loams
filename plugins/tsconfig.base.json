{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    // Node only. Every project extending this base is server-side (Cordis services and
    // adapters); core/dashboard-ui is the sole browser target and does not extend
    // this file. Naming it explicitly is what lets the type-aware lint program
    // (oxlint-tsgolint) see the Node globals -- left implicit, `Buffer.from(...)` in
    // bi was reported as TS2591 by `vp check` while `tsc -b` took it.
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "outDir": "lib",
    "rootDir": "src",
    "composite": true
  }
}
