{
  "name": "plugins-server",
  "projectType": "application",
  "sourceRoot": "plugins/apps/server/src",
  "tags": [
    "scope:plugins"
  ],
  "implicitDependencies": [
    "plugins-bi-rpc",
    "plugins-host",
    "plugins-agent-tools",
    "plugins-bi",
    "plugins-dashboards",
    "plugins-data",
    "plugins-charts",
    "plugins-chart-specs",
    "plugins-flows",
    "plugins-live",
    "plugins-plugin-forgejo-adapter",
    "plugins-plugin-glitchtip-adapter",
    "plugins-plugin-itsaplan-adapter",
    "plugins-plugin-langfuse-adapter",
    "plugins-engine",
    "plugins-plugin-matomo-adapter",
    "plugins-plugin-openpanel-adapter",
    "plugins-store",
    "plugins-plugin-zulip-adapter",
    "plugins-types"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "node -e \"process.exit(0)\"",
        "cwd": "plugins/apps/server"
      },
      "dependsOn": [
        {
          "projects": [
            "plugins"
          ],
          "target": "build"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "node -e \"process.exit(0)\"",
        "cwd": "plugins/apps/server"
      },
      "dependsOn": [
        {
          "projects": [
            "plugins"
          ],
          "target": "build"
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "pnpm run test apps/server/tests",
        "cwd": "plugins"
      },
      "dependsOn": []
    }
  }
}
