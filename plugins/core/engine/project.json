{
  "name": "plugins-engine",
  "projectType": "library",
  "sourceRoot": "plugins/core/engine/src",
  "tags": [
    "scope:plugins"
  ],
  "implicitDependencies": [
    "plugins-host",
    "plugins-http"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "node -e \"process.exit(0)\"",
        "cwd": "plugins/core/engine"
      },
      "dependsOn": [
        {
          "projects": [
            "plugins"
          ],
          "target": "build"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "node -e \"process.exit(0)\"",
        "cwd": "plugins/core/engine"
      },
      "dependsOn": [
        {
          "projects": [
            "plugins"
          ],
          "target": "build"
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/plugins/package.json",
        "{workspaceRoot}/plugins/tsconfig*.json",
        "{workspaceRoot}/plugins/vite.config.ts",
        "{workspaceRoot}/plugins/vitest.config.ts",
        "{workspaceRoot}/plugins/project.json",
        "{workspaceRoot}/plugins/core/**/*",
        "{workspaceRoot}/plugins/packages/**/*",
        "{workspaceRoot}/plugins/apps/**/*",
        "{workspaceRoot}/plugins/proto/**/*",
        "{workspaceRoot}/plugins/scripts/**/*",
        "{workspaceRoot}/plugins/buf*.yaml",
        "!{workspaceRoot}/plugins/**/node_modules/**/*",
        "!{workspaceRoot}/plugins/**/lib/**/*",
        "!{workspaceRoot}/plugins/**/dist/**/*",
        "!{workspaceRoot}/plugins/**/*.tsbuildinfo",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json"
      ],
      "outputs": [],
      "options": {
        "command": "pnpm run test core/engine/tests",
        "cwd": "plugins"
      },
      "dependsOn": []
    }
  }
}
