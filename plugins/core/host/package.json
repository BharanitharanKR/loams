{
  "name": "@loams-core/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @loams-plugins/root build",
    "test": "pnpm --filter @loams-plugins/root test core/host/tests"
  },
  "dependencies": {
    "@loams-core/dashboards": "workspace:*",
    "@loams-core/store": "workspace:*",
    "@loams-core/http": "workspace:*",
    "@loams-core/types": "workspace:*",
    "cookie": "^1.1.1",
    "cordis": "^4.0.0-rc.10",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "//": "The `exports` map is what makes `@loams-core/host/ui` resolve. Without it the subpath is unreachable under `moduleResolution: bundler`, and dashboard-ui's `import { CoreShell } from \"@loams-core/host/ui\"` has no entry to land on. `main`/`types` stay for tools that predate `exports`.",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
