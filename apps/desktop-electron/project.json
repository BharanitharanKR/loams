{
	"name": "loams-desktop-electron",
	"projectType": "application",
	"sourceRoot": "apps/desktop-electron/src",
	"tags": ["scope:desktop", "type:application", "platform:electron"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/out"],
			"options": { "cwd": "apps/desktop-electron", "command": "pnpm run build" }
		},
		"test": {
			"executor": "nx:run-commands",
			"options": { "cwd": "apps/desktop-electron", "command": "pnpm run test" }
		},
		"e2e": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build", "@loams/console:build"],
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "pnpm run test:e2e"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "pnpm run typecheck"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": { "cwd": "apps/desktop-electron", "command": "pnpm run dev" }
		},
		"package-linux": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build", "@loams/console:build"],
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "node scripts/fetch-engine.mjs && pnpm run package --linux --publish never"
			}
		},
		"package-macos": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build", "@loams/console:build"],
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "node scripts/fetch-engine.mjs && pnpm run package --mac --publish never"
			}
		},
		"package-windows-unpacked": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build", "@loams/console:build"],
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "node scripts/fetch-engine.mjs && pnpm run package --win --dir --x64 --publish never"
			}
		},
		"package-windows": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build", "@loams/console:build"],
			"options": {
				"cwd": "apps/desktop-electron",
				"command": "node scripts/fetch-engine.mjs && pnpm run package --win --publish never"
			}
		}
	}
}
