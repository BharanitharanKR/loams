<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AP3 Ruling 1. Applied only to signed builds (TODO(Q420)); CI builds unsigned. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.loams.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.loams.app.shared</string>
	</array>
</dict>
</plist>
