{
  "name": "mobile-mock",
  "projectType": "application",
  "sourceRoot": "apps/mobile/mock",
  "tags": ["scope:mobile", "language:go"],
  "implicitDependencies": ["mobile-contracts", "mobile-fixtures"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "inputs": ["{projectRoot}/**/*", "!{projectRoot}/bin/**/*", {"runtime": "go -C apps/mobile/mock version"}, {"runtime": "go -C apps/mobile/mock env -json"}],
      "outputs": ["{projectRoot}/bin/loams-mock"],
      "options": {"cwd": "apps/mobile/mock", "command": "CGO_ENABLED=0 go build -trimpath -buildvcs=false -o bin/loams-mock ./cmd/loams-mock"}
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"cwd": "apps/mobile/mock", "command": "go test -race -count=1 ./..."}
    },
    "vet": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "!{projectRoot}/bin/**/*", {"runtime": "go -C apps/mobile/mock version"}, {"runtime": "go -C apps/mobile/mock env -json"}],
      "outputs": [],
      "options": {"cwd": "apps/mobile/mock", "command": "CGO_ENABLED=0 go vet ./..."}
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"cwd": "apps/mobile/mock", "command": "go run ./cmd/loams-mock -listen 127.0.0.1:8084 -public-url http://127.0.0.1:8084 -qr=false"}
    }
  }
}
