{
  "name": "@loams/proto",
  "version": "0.1.0",
  "private": true,
  "description": "Generated protobuf-es messages and Connect service descriptors for the Loams app protos (design §37 §8): loams.instance, devices, approvals, operations, notifications and errors v1, plus the collection, SQL, stream, live, graph and house data planes, the console API (loams.auth.v1 and loams.admin.v1), and loams-agentd's loams.agentd.v1 for Loams Studio.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ostrium-labs/loams",
    "directory": "web/packages/proto"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./admin": "./src/admin.ts",
    "./admin/agent": "./src/gen/loams/admin/v1/agent_pb.ts",
    "./admin/audit": "./src/gen/loams/admin/v1/audit_pb.ts",
    "./admin/common": "./src/gen/loams/admin/v1/common_pb.ts",
    "./admin/key": "./src/gen/loams/admin/v1/key_pb.ts",
    "./admin/org": "./src/gen/loams/admin/v1/org_pb.ts",
    "./admin/project": "./src/gen/loams/admin/v1/project_pb.ts",
    "./auth": "./src/gen/loams/auth/v1/auth_pb.ts",
    "./agentd": "./src/agentd.ts",
    "./approvals": "./src/gen/loams/approvals/v1/approvals_pb.ts",
    "./collection": "./src/gen/loams/collection/v1/collection_pb.ts",
    "./collection-v1": "./src/collection-v1.ts",
    "./documents": "./src/gen/loams/collection/v1/document_pb.ts",
    "./query": "./src/gen/loams/collection/v1/query_pb.ts",
    "./devices": "./src/gen/loams/devices/v1/devices_pb.ts",
    "./errors": "./src/gen/loams/errors/v1/errors_pb.ts",
    "./graph": "./src/gen/loams/graph/v1/graph_pb.ts",
    "./house": "./src/gen/loams/house/v1/house_pb.ts",
    "./instance": "./src/gen/loams/instance/v1/instance_pb.ts",
    "./live": "./src/gen/loams/live/v1/live_pb.ts",
    "./live-admin": "./src/gen/loams/live/v1/admin_pb.ts",
    "./live-value": "./src/gen/loams/live/v1/value_pb.ts",
    "./notifications": "./src/gen/loams/notifications/v1/notifications_pb.ts",
    "./options": "./src/gen/loams/options/v1/options_pb.ts",
    "./sql": "./src/gen/loams/sql/v1/sql_pb.ts",
    "./stream": "./src/gen/loams/stream/v1/stream_pb.ts",
    "./operations": "./src/gen/loams/operations/v1/operations_pb.ts"
  },
  "scripts": {
    "generate": "cd ../../.. && buf generate --template buf.gen.apps.yaml",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "testRuntime",
          "graphConformance"
        ]
      }
    }
  }
}
