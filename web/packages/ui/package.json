{
  "name": "@loams/ui",
  "version": "0.1.0",
  "description": "Loams's design system: tokens, the mark, grain textures and React primitives.",
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ostrium-labs/loams",
    "directory": "web/packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./tokens.css": "./src/tokens.css"
    }
  },
  "files": [
    "dist",
    "src/*.css",
    "README.md",
    "NOTICE",
    "LICENSE.t3code",
    "provenance.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-sql": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@lezer/highlight": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:"
  }
}
