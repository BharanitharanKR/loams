{
  "name": "@loams/charts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared live charts for the console and desktop: LiveChart, Sparkline and useMetricStream over the @loams-core/charts compiler and ECharts, themed from @loams/ui tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./gallery": {
      "types": "./src/gallery.tsx",
      "default": "./src/gallery.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams-core/chart-specs": "workspace:*",
    "@loams-core/charts": "workspace:*",
    "@loams-core/types": "workspace:*",
    "@loams/ui": "workspace:*",
    "echarts": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
