{
  "name": "@loams/platform-electron",
  "version": "0.1.0",
  "private": true,
  "description": "The Electron desktop's `platform`, `transport` and `desktop` services for the Loams console (AP1e).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "core",
      "inject": [],
      "provides": [
        "platform",
        "transport",
        "desktop"
      ],
      "slots": [],
      "permissions": [],
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*"
  },
  "devDependencies": {
    "@loams/desktop": "workspace:*",
    "@loams/platform-web": "workspace:*",
    "@loams/proto": "workspace:*",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
