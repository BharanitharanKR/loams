{
  "name": "@loams/console-host",
  "version": "0.1.0",
  "private": true,
  "description": "The Loams console host: boots a cordis context from a plugin catalog, decides trust tiers, guards first-party plugins, sandboxes third-party ones, and provides the core services (design §37 §5, AP1a).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query.ts",
      "default": "./src/query.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "default": "./src/theme.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./plugin-manifest.schema.json": "./plugin-manifest.schema.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/agentd-client": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "yaml": "2.9.1",
    "@connectrpc/connect-query": "catalog:",
    "@tanstack/react-query": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "testRuntime",
          "{workspaceRoot}/release/upgrade-path.toml",
          "{workspaceRoot}/web/plugins/sandbox/static/frame.html"
        ]
      }
    }
  }
}
