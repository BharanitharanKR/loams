{
  "name": "@loams/studio-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Studio's component library: UI and logic vendored from T3 Code (MIT) and rebuilt on the Loams stack, with provenance.json and LICENSE.t3code (design \u00a753 \u00a79, D912, D913; plan SD1 Task 1).",
  "license": "Apache-2.0 AND MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./chat": {
      "types": "./src/chat/index.ts",
      "default": "./src/chat/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown/index.ts",
      "default": "./src/markdown/index.ts"
    },
    "./approvals": {
      "types": "./src/approvals/index.ts",
      "default": "./src/approvals/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams/agentd-client": "workspace:*",
    "@loams/ui": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "lucide-react": "catalog:",
    "react-markdown": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gfm": "catalog:",
    "shiki": "catalog:",
    "unified": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
