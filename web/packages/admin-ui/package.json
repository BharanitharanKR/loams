{
  "name": "@loams/admin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "What the console's org, project, agent and audit pages share (API2 Task 10): page heads, the audit table, the activity chart, labels for the loams.admin.v1 enums and the pages' styles, in the original console's look.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.tsx",
      "default": "./src/testing.tsx"
    },
    "./admin.css": "./src/admin.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "catalog:",
    "@loams/console-host": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
