{
  "name": "@loams/plugin-pipelines",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the Pipelines page. A visual builder for CN2 connector pipelines (sources, transforms, sinks) with schema checks, deploy, and live per-node throughput and lag.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "router",
        "slots"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0"
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams-core/flows": "workspace:*",
    "@loams/charts": "workspace:*",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/desktop-ui": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "@xyflow/react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
