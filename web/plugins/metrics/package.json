{
  "name": "@loams/plugin-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the Metrics page. Editable live dashboards (usage, Postgres, Loams SQL, Live, House) laid out as @loams-core/dashboards specs and drawn with @loams/charts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "router",
        "slots"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0"
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams-core/types": "workspace:*",
    "@loams/charts": "workspace:*",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "react-grid-layout": "2.3.0",
    "react-resizable": "4.0.2"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
