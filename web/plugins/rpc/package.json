{
  "name": "@loams/plugin-rpc",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Connect clients as cordis services, one `rpc.<service>` per app proto, provided only when the instance serves the package (design §37 §5.4, AP1a Ruling 6).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "core",
      "inject": [
        "transport",
        "flags"
      ],
      "provides": [
        "rpc.instance",
        "rpc.approvals",
        "rpc.operations",
        "rpc.devices",
        "rpc.notifications",
        "rpc.auth",
        "rpc.org",
        "rpc.projects",
        "rpc.agents",
        "rpc.keys",
        "rpc.audit"
      ],
      "slots": [],
      "permissions": [],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
