{
  "name": "@loams/plugin-shell",
  "version": "0.1.0",
  "private": true,
  "description": "The console's layout, navigation and the `router` service (design §37 §5.4–§5.5).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "core",
      "inject": [
        "slots",
        "session",
        "flags",
        "mode",
        "theme"
      ],
      "provides": [
        "router",
        "inspector",
        "drawer"
      ],
      "slots": [
        "root",
        "console.nav",
        "console.page",
        "shell.overlay",
        "shell.nav.section",
        "shell.dock.right",
        "shell.header.server",
        "shell.nav.context",
        "shell.sidebar.server",
        "shell.sidebar.threads",
        "shell.topbar.left",
        "shell.topbar.center",
        "shell.topbar.right",
        "shell.home",
        "shell.inspector.tab",
        "shell.drawer.tab",
        "palette.command",
        "shell.palette.source",
        "console.settings.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@loams/studio-ui": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "testRuntime",
          "webTree"
        ]
      }
    }
  }
}
