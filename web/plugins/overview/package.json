{
  "name": "@loams/plugin-overview",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the Overview home page, a live dashboard over a grid of honest status cards.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "desktop",
        "router",
        "slots",
        "platform",
        "transport"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section",
        "environment.overview.card"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@connectrpc/connect": "2.2.0",
    "@loams/charts": "workspace:*",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/durable-client": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "@xyflow/react": "12.12.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "@loams/desktop": "workspace:*",
    "@loams/platform-electron": "workspace:*"
  }
}
