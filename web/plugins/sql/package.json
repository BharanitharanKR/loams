{
  "name": "@loams/plugin-sql",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop: the Loams SQL (TiDB, MySQL-compatible) page. Databases, branches, suspend and resume, connection details and an SQL editor over loams.sqldb.v1 (mocked until the protos land).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "platform",
        "router",
        "slots"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "shell.nav.section"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0"
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/desktop-ui": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "@loams/desktop": "workspace:*",
    "@loams/platform-electron": "workspace:*"
  }
}
