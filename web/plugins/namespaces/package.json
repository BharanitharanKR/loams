{
  "name": "@loams/plugin-namespaces",
  "version": "0.1.0",
  "private": true,
  "description": "The environments the signed-in principal can reach and their engine namespaces.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "session",
        "router",
        "transport"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "console.nav"
      ],
      "permissions": [
        "instance:read"
      ],
      "requires": {
        "console": "^0.1.0",
        "api": [
          "loams.instance.v1"
        ]
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
