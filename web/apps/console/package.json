{
  "name": "@loams/console",
  "version": "0.1.0",
  "private": true,
  "description": "The Loams console: one single-page app for OSS, Loams Cloud and BYOC (design §19 P1).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
