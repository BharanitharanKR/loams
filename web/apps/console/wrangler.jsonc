// The hosted console on Cloudflare Workers static assets (issue #269): Ostrium's
// at console.loams.dev, or yours with `--env byoc` (a workers.dev URL, no custom
// domain; add your own route). Assets only, no Worker code, so it stays on the
// free plan. Build and stage first (web/README.md "Deploy the console"); the
// stage step writes config.json from LOAMS_ENGINE_URL, LOAMS_AUTH_MODE
// (oidc | tailscale | apikey, default oidc), LOAMS_AUTH_ISSUER and
// LOAMS_AUTH_CLIENT_ID. A console of your own registers its client id at
// https://auth.loams.dev/register:
//   pnpm build && LOAMS_AUTH_MODE=oidc LOAMS_AUTH_CLIENT_ID=<yours> node apps/console/deploy/stage.mjs
//   cd apps/console && wrangler deploy            # console.loams.dev
//   cd apps/console && wrangler deploy --env byoc # your account
{
  "name": "loams-console",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist-cloudflare",
    // Exact paths: the sandbox frame keeps its own headers, no canonical redirects.
    "html_handling": "none",
    // Unknown paths get /index.html, the console (it routes by hash).
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "console.loams.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    "byoc": {
      "name": "loams-console",
      "routes": [],
      "workers_dev": true
    }
  }
}
