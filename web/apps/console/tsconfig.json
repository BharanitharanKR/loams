{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // @loams/charts and @loams/plugin-pipelines import core compilers from their
    // source files (@loams-core/*/src/compiler.ts), not the Node-only package roots.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"],
  // Playwright's specs run in Node: test/e2e/tsconfig.json checks them.
  "exclude": ["test/e2e"]
}
