# Buck2 builds, lints and tests the Rust workspaces (owner, 2026-10-24).
# Cargo stays the source of truth: third-party/rust/BUCK comes from reindeer
# and the crates' BUCK files from scripts/buck/gen.py; see docs/guides/buck2.md.
# Tools: scripts/buck/bootstrap.sh (pins in scripts/buck/versions.env).
[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# The prelude bundled in the pinned buck2 binary.
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

[buildfile]
  name = BUCK

# Not source: tool installs, dependencies and other build systems' output.
[project]
  ignore = .git, .tools, node_modules, **/node_modules, target, **/target, .nx, fabric/target

[rust]
  # Cargo's dev profile: line tables, no incremental (CI sets that too).
  incremental = false

[buck2]
  # Outputs are downloaded or written to disk only when something needs them.
  materializations = deferred
