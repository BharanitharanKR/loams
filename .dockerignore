# Build context of deploy/release/Containerfile.* (built from the repository
# root by deploy/release/build.sh). Keeps VCS data, build output and JS
# dependencies out of the context; sources stay in, since crates read files
# across the tree (protos, docs) at build time.
.git
**/target
**/node_modules
**/dist
**/.loams
apps/desktop-electron
apps/mobile
# The console stage (Containerfile.loams) installs from the pnpm workspace,
# whose lockfile names every member, and the console imports the desktop's
# shared contracts (@loams/desktop/contracts): keep those two.
!apps/desktop-electron/package.json
!apps/desktop-electron/src/shared
