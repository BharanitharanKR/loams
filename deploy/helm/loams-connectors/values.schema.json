{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loams-connectors values",
  "type": "object",
  "required": ["image", "flow", "namespaceTemplate", "servedNamespaces", "cluster", "fabric", "fallback"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$" },
        "digest": {
          "description": "Images are pinned by digest (Global Constraints, Pins): sha256:<64 lowercase hex>.",
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "cidrs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$" }
    },
    "fallbackRuntime": {
      "type": "object",
      "required": ["image", "uid", "metricsPort", "metricsPath", "resources"],
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "uid": { "type": "integer", "minimum": 1 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPath": { "type": "string", "pattern": "^/" },
        "resources": {
          "type": "object",
          "required": ["cpuRequest", "memoryRequest", "memoryLimit"],
          "additionalProperties": false,
          "properties": {
            "cpuRequest": { "type": "string" },
            "memoryRequest": { "type": "string" },
            "memoryLimit": { "type": "string" }
          }
        },
        "storage": {
          "type": "object",
          "required": ["size"],
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "required": ["flow"],
      "properties": { "flow": { "$ref": "#/definitions/image" } }
    },
    "flow": {
      "type": "object",
      "required": ["replicas", "podBudget", "metricsPort", "uid", "resources", "pdb"],
      "properties": {
        "replicas": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "podBudget": {
          "type": "object",
          "required": ["memoryBytes", "maxInstances"],
          "properties": {
            "memoryBytes": { "type": "integer", "minimum": 1 },
            "maxInstances": { "type": "integer", "minimum": 1 }
          }
        },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "uid": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "pdb": {
          "type": "object",
          "required": ["maxUnavailable"],
          "properties": { "maxUnavailable": { "type": ["integer", "string"] } }
        }
      }
    },
    "namespaceTemplate": { "type": "string", "pattern": "\\{ns\\}" },
    "servedNamespaces": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "cluster": {
      "type": "object",
      "required": ["podCidrs", "serviceCidrs", "controlPlane"],
      "properties": {
        "podCidrs": { "$ref": "#/definitions/cidrs" },
        "serviceCidrs": { "$ref": "#/definitions/cidrs" },
        "controlPlane": {
          "type": "object",
          "required": ["cidrs", "hosts"],
          "properties": {
            "cidrs": { "$ref": "#/definitions/cidrs" },
            "hosts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "fabric": {
      "type": "object",
      "required": ["podLabels", "ports"],
      "properties": {
        "namespace": { "type": "string" },
        "podLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["secretMountRoot", "camel", "debezium", "iggy"],
      "properties": {
        "serviceAccount": { "type": "string" },
        "secretMountRoot": { "type": "string", "pattern": "^/" },
        "camel": { "$ref": "#/definitions/fallbackRuntime" },
        "debezium": {
          "allOf": [
            { "$ref": "#/definitions/fallbackRuntime" },
            { "required": ["storage"] }
          ]
        },
        "iggy": { "$ref": "#/definitions/fallbackRuntime" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "metrics": { "type": "object" }
  }
}
