# The local CI runner's userland: Ubuntu 24.04, like GitHub's ubuntu-24.04 runners, so
# workflow steps (`sudo apt-get install ...`, setup-* actions, docker) work unchanged.
# Built by setup-host.sh as the ci user (rootless podman): root in here is the
# unprivileged ci user on the host, so `sudo` inside a job grants nothing on the host.
#
# The GitHub runner itself is not in the image: it lives on the host under
# /mnt/Projects/ci/runners/<name>/runner and is mounted at the same path, so the
# paths it hands to job and service containers (started through the ci user's
# podman socket) exist on the host too.
ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE}

ARG RUSTUP_VERSION
ARG RUSTUP_SHA256
ARG DOCKER_CLI_VERSION
ARG DOCKER_APT_FINGERPRINT
# GitHub CLI's apt signing key.
ARG GH_APT_FINGERPRINT=2C6106201985B60E6C7AC87323F3D4EA75716059

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    TZ=Etc/UTC

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl wget gnupg git git-lfs jq sudo unzip zip xz-utils zstd \
      tar gzip bzip2 file less openssh-client rsync tzdata locales \
      build-essential pkg-config cmake ninja-build clang lld libclang-dev \
      libssl-dev zlib1g-dev libsqlite3-dev libcurl4-openssl-dev \
      protobuf-compiler libprotobuf-dev \
      python3 python3-pip python3-venv \
      libicu74 libkrb5-3 liblttng-ust1t64 \
 && rm -rf /var/lib/apt/lists/*

# Docker CLI, buildx and compose, checked against Docker's signing key.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.asc \
 && gpg --show-keys --with-colons /tmp/docker.asc | grep -q "^fpr:::::::::${DOCKER_APT_FINGERPRINT}:" \
 && gpg --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc && rm /tmp/docker.asc \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli.gpg \
 && gpg --show-keys --with-colons /etc/apt/keyrings/githubcli.gpg | grep -q "^fpr:::::::::${GH_APT_FINGERPRINT}:" \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/githubcli.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      "docker-ce-cli=${DOCKER_CLI_VERSION}" docker-buildx-plugin docker-compose-plugin gh \
 && rm -rf /var/lib/apt/lists/*

# rustup-init; the entrypoint installs rustup into the persistent CARGO_HOME on first start.
RUN curl -fsSL -o /usr/local/bin/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "${RUSTUP_SHA256}  /usr/local/bin/rustup-init" | sha256sum -c - \
 && chmod 755 /usr/local/bin/rustup-init

COPY entrypoint.sh /usr/local/bin/loams-runner-entrypoint
COPY hooks/ /usr/local/lib/loams-runner/hooks/
RUN chmod 755 /usr/local/bin/loams-runner-entrypoint /usr/local/lib/loams-runner/hooks/*.sh

ENTRYPOINT ["/usr/local/bin/loams-runner-entrypoint"]
