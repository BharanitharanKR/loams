# Pinned versions and SHA-256 digests for the local CI hosts (docs/guides/local-ci.md).
# Every download is checked against the digest here before it is unpacked. The
# digests come from the GitHub release API's asset `digest` field (or the
# vendor's SHASUMS file) and were re-checked on download. Bump a version and its
# digest together, in one commit.

# NativeLink (Apache-2.0): remote cache, scheduler and worker.
# https://github.com/TraceMachina/nativelink/releases/tag/v1.7.7
NATIVELINK_VERSION=1.7.7
NATIVELINK_SHA256=6e8f964c5d39434410ea6f5cc6251c0834bf6afd075e184538425016567848e9

# sccache (Apache-2.0): rustc output cache for plain cargo builds, WebDAV backend.
# https://github.com/mozilla/sccache/releases/tag/v0.18.0
SCCACHE_VERSION=0.18.0
SCCACHE_SHA256=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89

# dufs (MIT OR Apache-2.0): the WebDAV server that stores sccache's entries on the primary.
# https://github.com/sigoden/dufs/releases/tag/v0.46.0
DUFS_VERSION=0.46.0
DUFS_SHA256=817769f726613194bcff9d0e3e481eaccc86ac11208857614f36a8c02f410977

# GitHub Actions runner (MIT). The runner updates itself when GitHub requires a newer one.
# https://github.com/actions/runner/releases/tag/v2.338.1
RUNNER_VERSION=2.338.1
RUNNER_SHA256=08e9ccb3604d2462c24b5e33604dc30810296ca15cc65f23cffd4317eb144c37

# The runner image's base: ubuntu:24.04, the userland GitHub's ubuntu-24.04 runners have.
UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:a2d43bffc46670d7108bb3c0468c67c5557c4c92e83e1e34cbff1322ad1b94dc

# rustup-init (for the runner image; the toolchain itself follows rust-toolchain.toml).
# https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init.sha256
RUSTUP_VERSION=1.29.2
RUSTUP_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4

# Docker CLI in the runner image (talks to the ci user's rootless podman socket), from
# Docker's apt repository (GPG-checked). Its signing key's fingerprint:
DOCKER_CLI_VERSION=5:29.9.2-1~ubuntu.24.04~noble
DOCKER_APT_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
