{
  "name": "loams-cloud",
  "private": true,
  "type": "module",
  "description": "The Loams Cloud control plane Worker (design 78 §25, plan LC1 LC2a): the invite-only waitlist, invitations and admin API. One runtime dependency, @tidbcloud/serverless, used only by src/worker.ts; the tests need none.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test test/*.test.ts",
    "test:tidb": "scripts/test-tidb.sh",
    "typecheck": "tsc --noEmit -p .",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@tidbcloud/serverless": "0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "wrangler": "4.149.0"
  }
}
