# Copy to .env (chmod 600) and fill in. Never commit .env.
# Generate secrets with the command in each comment.

# --- Authentik core ----------------------------------------------------------
# openssl rand -base64 60 | tr -d '\n'   Changing it later invalidates sessions
# and encrypted fields: keep a copy in the password manager with the DB backups.
AUTHENTIK_SECRET_KEY=
# openssl rand -base64 36 | tr -d '\n'   (avoid '#', quotes and '$')
PG_PASS=
PG_USER=authentik
PG_DB=authentik

# First start only: password and email of the built-in `akadmin` user. Setting
# these avoids exposing /if/flow/initial-setup/ on the public hostname. Remove
# them from .env after the first login.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=

# --- Email (enrollment verification, recovery) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM="Loams <no-reply@loams.dev>"

# --- Loams blueprints (read by the worker) -----------------------------------
# Secret of the `loams-cloud` OAuth2 client; the site stores the same value as
# AUTH_AUTHENTIK_SECRET. openssl rand -hex 32
LOAMS_CLOUD_CLIENT_SECRET=
# Secret of the `headscale` OAuth2 client (loams-05-headscale.yaml). Generate one
# now even if Headscale is not deployed yet; it is the value Headscale reads as
# HEADSCALE_OIDC_CLIENT_SECRET later. openssl rand -hex 32
HEADSCALE_OIDC_CLIENT_SECRET=
# Exact origin of the Workers preview deployment allowed to sign in.
LOAMS_PREVIEW_ORIGIN=https://preview.loams.dev
# false = invitation-only (beta). true = anyone can sign up.
LOAMS_ENROLLMENT_OPEN=false
LOAMS_AUTH_DOMAIN=auth.loams.dev

# --- Cloudflare Tunnel --------------------------------------------------------
# Zero Trust > Networks > Tunnels > your tunnel > token (docs/platform/deploy/authentik.md).
TUNNEL_TOKEN=

# --- Private network (optional; docker compose --profile tailnet up -d) ------------
# Provider switch, configuration only (docs/platform/deploy/tailnet.md):
#   tailscale  TAILNET_LOGIN_SERVER empty = Tailscale's hosted service (default)
#   headscale  TAILNET_LOGIN_SERVER=https://headscale.loams.dev
# ../../tailnet/check-env.sh .env  checks the pair is consistent.
TAILNET_PROVIDER=tailscale
TAILNET_LOGIN_SERVER=
# Tagged auth key for this node (Tailscale admin > Settings > Keys; Headscale:
# `headscale preauthkeys create --tags tag:authentik`). Never commit it.
TS_AUTHKEY=
# Must be a tag the key is allowed to carry and policy.hujson grants tcp:9000 to
# group:ops on (deploy/tailnet/policy/policy.hujson uses tag:authentik).
TS_TAGS=tag:authentik
TS_HOSTNAME=ak-1

# --- Backups: nightly pg_dump to an S3-compatible bucket (rclone) --------------
# Cloudflare R2: PROVIDER=Cloudflare, ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RustFS / MinIO-style: PROVIDER=Other, ENDPOINT=https://rustfs.example.net
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=authentik
BACKUP_AT=03:15
BACKUP_RETENTION_DAYS=30
# Optional dead-man's switch (for example a healthchecks.io ping URL).
BACKUP_HEARTBEAT_URL=
