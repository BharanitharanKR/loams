{
  "title": "Loams House",
  "uid": "loams-house",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "loams",
    "house"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Loams House fronts: statements, admission, workers, house-cache, commits, compaction, pipes, quotas and the query log (HS1 Task 23, design \u00a749 \u00a715).",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(loams_house_workers, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "label": "Front"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Statements",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Statements per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(loams_house_queries_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Statement latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loams_house_query_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loams_house_query_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loams_house_query_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Statements by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(loams_house_queries_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes read, written and returned",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loams_house_read_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "expr": "sum(rate(loams_house_written_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "written"
        },
        {
          "refId": "C",
          "expr": "sum(rate(loams_house_result_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "result"
        }
      ]
    },
    {
      "type": "row",
      "title": "Admission and workers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Admission",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(loams_house_queue_depth{instance=~\"$instance\"})",
          "legendFormat": "queued"
        },
        {
          "refId": "B",
          "expr": "sum(loams_house_admitted_queries{instance=~\"$instance\"})",
          "legendFormat": "running"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workers by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (loams_house_workers{instance=~\"$instance\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker kills by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(loams_house_worker_kills_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker boot (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loams_house_worker_boot_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "row",
      "title": "house-cache",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loams_house_cache_hits_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(loams_house_cache_hits_total{instance=~\"$instance\"}[$__rate_interval])) + sum(rate(loams_house_cache_misses_total{instance=~\"$instance\"}[$__rate_interval])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes served to workers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loams_house_cache_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "served"
        }
      ]
    },
    {
      "type": "row",
      "title": "Commits and compaction",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Commit latency (p95) and conflicts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loams_house_commit_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 seconds"
        },
        {
          "refId": "B",
          "expr": "sum(rate(loams_house_commit_conflicts_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "conflicts/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Compactions by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(loams_house_compaction_runs_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ingest, quotas and the query log",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pipe lag (records)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (ns, pipe) (loams_house_pipe_lag_records{instance=~\"$instance\"})",
          "legendFormat": "{{ns}} {{pipe}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quota refusals",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (quota) (rate(loams_house_quota_refusals_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{quota}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query log rows",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 61
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(loams_house_query_log_rows_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(loams_house_query_log_pending_rows{instance=~\"$instance\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Usage events",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 61
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(loams_house_usage_events_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
