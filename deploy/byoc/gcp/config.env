# Settings for the Google Cloud VM (rendered into /etc/loams-byoc/config.env). No keys.
LOAMS_BYOC_CLOUD=gcp
LOAMS_VERSION=@@VERSION@@
LOAMS_BUCKET_URL=gs://@@BUCKET@@/loams
GCP_PROJECT=@@PROJECT@@
SECRET_PREFIX=@@SECRET_PREFIX@@
LOAMS_PROFILES=@@PROFILES@@
TS_HOSTNAME=@@HOSTNAME@@
DATA_DEVICE=@@DATA_DEVICE@@
