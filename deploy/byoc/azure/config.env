# Settings for the Azure VM (rendered into /etc/loams-byoc/config.env). No keys.
LOAMS_BYOC_CLOUD=azure
LOAMS_VERSION=@@VERSION@@
LOAMS_BUCKET_URL=az://@@CONTAINER@@/loams
AZURE_ACCOUNT=@@STORAGE_ACCOUNT@@
AZURE_VAULT=@@VAULT@@
AZURE_CLIENT_ID=@@CLIENT_ID@@
SECRET_PREFIX=@@SECRET_PREFIX@@
LOAMS_PROFILES=@@PROFILES@@
TS_HOSTNAME=@@HOSTNAME@@
DATA_DEVICE=@@DATA_DEVICE@@
