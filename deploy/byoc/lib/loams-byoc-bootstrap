#!/usr/bin/env bash
# First boot of a Loams BYOC VM (Ubuntu 24.04): mounts the data disk, installs
# Docker, downloads the pinned compose bundle for LOAMS_VERSION, checks its
# signature and checksum, writes .env and secrets/engine.env (settings only,
# never a cloud key), and enables loams-byoc.service, which fetches the
# secrets and starts the stack. Safe to run again.
#
#   loams-byoc-bootstrap                    install and enable
#   loams-byoc-bootstrap --render-env-only  print the .env and engine.env it
#                                           would write (secrets as placeholders)
#                                           and touch nothing (for tests)
#   LOAMS_BYOC_SKIP_SYSTEM=1                download, verify and unpack the bundle and
#                                           write .env and secrets/engine.env under
#                                           LOAMS_BYOC_ROOT, but skip the root check,
#                                           kernel, disk, Docker and systemd steps
#                                           (for tests, not for a VM)
set -euo pipefail
umask 022

config="${LOAMS_BYOC_CONFIG:-/etc/loams-byoc/config.env}"
# shellcheck disable=SC1090
. "$config"
render_only=0
[[ "${1:-}" == "--render-env-only" ]] && render_only=1

root="${LOAMS_BYOC_ROOT:-/opt/loams}"
stack="$root/release"
repo="${LOAMS_BYOC_RELEASE_URL:-https://github.com/ostrium-labs/loams/releases/download}"
# The release signing key (docs/release/loams-release-key.asc); the bundle's
# SHA256SUMS.asc must verify against this fingerprint.
fpr="333AC94599D5A1EB2A416D1E83DC134D8CAF895D"
proto='=https'
keyfile="${LOAMS_BYOC_KEY:-/etc/loams-byoc/loams-release-key.asc}"
docker_fpr="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"

say() { echo "loams-byoc-bootstrap: $*"; }
die() { echo "loams-byoc-bootstrap: $*" >&2; exit 1; }

: "${LOAMS_BYOC_CLOUD:?}" "${LOAMS_VERSION:?}" "${LOAMS_BUCKET_URL:?}" "${SECRET_PREFIX:?}"
[[ "$LOAMS_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.]+)?$ ]] \
  || die "LOAMS_VERSION must be a release version, not '$LOAMS_VERSION'"
case "$LOAMS_BYOC_CLOUD:$LOAMS_BUCKET_URL" in
  aws:s3://*|gcp:gs://*|azure:az://*) ;;
  *) die "LOAMS_BUCKET_URL $LOAMS_BUCKET_URL does not match cloud $LOAMS_BYOC_CLOUD" ;;
esac

# The settings the stack reads, cloud by cloud. None is a credential: the
# engine's object_store reads the instance role (AWS), the metadata server's
# service account (GCP) or the managed identity (Azure).
engine_env() {
  case "$LOAMS_BYOC_CLOUD" in
    aws) echo "AWS_REGION=${REGION:?REGION is not set}" ;;
    gcp) ;;
    azure)
      echo "AZURE_STORAGE_ACCOUNT_NAME=${AZURE_ACCOUNT:?AZURE_ACCOUNT is not set}"
      echo "AZURE_CREDENTIAL_TYPE=managed_identity"
      [[ -z "${AZURE_CLIENT_ID:-}" ]] || echo "AZURE_STORAGE_CLIENT_ID=$AZURE_CLIENT_ID"
      ;;
  esac
}

env_values() {
  printf 'LOAMS_VERSION=%s\n' "$LOAMS_VERSION"
  printf 'LOAMS_BUCKET=%s\n' "$LOAMS_BUCKET_URL"
  printf 'COMPOSE_PROFILES=%s\n' "${LOAMS_PROFILES:-}"
  printf 'TS_HOSTNAME=%s\n' "${TS_HOSTNAME:-loams}"
  printf 'TS_AUTHKEY=%s\n' '<from secret store>'
  printf 'LOAMS_SETUP_TOKEN=%s\n' '<from secret store>'
}

if ((render_only)); then
  echo "# .env"; env_values
  echo "# secrets/engine.env"; engine_env
  exit 0
fi

skip_system="${LOAMS_BYOC_SKIP_SYSTEM:-0}"
[[ "$skip_system" == 1 || "$(id -u)" -eq 0 ]] || die "run as root"
if [[ "$skip_system" == 1 ]]; then
  # Test hooks, only without the system steps: a local release, signed by a test key.
  proto='=http,https'
  fpr="${LOAMS_BYOC_TEST_KEY_FPR:-$fpr}"
fi

# --- kernel (House's workers need Linux 6.7 or newer) ------------------------
kv="$(uname -r)"; maj="${kv%%.*}"; rest="${kv#*.}"; min="${rest%%[!0-9]*}"
if [[ "$skip_system" != 1 ]] && ((maj < 6 || (maj == 6 && min < 7))); then
  die "Linux $kv is too old: the House needs 6.7 or newer (Ubuntu 24.04's 6.8 or later)"
fi

# --- the data disk, if one is attached ----------------------------------------
if [[ "$skip_system" != 1 && -n "${DATA_DEVICE:-}" ]]; then
  for _ in $(seq 30); do [[ -b "$DATA_DEVICE" ]] && break; sleep 2; done
  [[ -b "$DATA_DEVICE" ]] || die "data disk $DATA_DEVICE did not appear"
  if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    say "formatting $DATA_DEVICE as ext4 (the embedded stores need a local block disk)"
    mkfs.ext4 -q -L loams-data "$DATA_DEVICE"
  fi
  mkdir -p /var/lib/docker
  grep -q ' /var/lib/docker ' /etc/fstab \
    || echo "LABEL=loams-data /var/lib/docker ext4 defaults,nofail 0 2" >>/etc/fstab
  mountpoint -q /var/lib/docker || mount /var/lib/docker
fi

# --- Docker (the vendor's apt repository, key checked by fingerprint) ----------
if [[ "$skip_system" != 1 ]] && { ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; }; then
  say "installing Docker"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg jq
  install -m 0755 -d /etc/apt/keyrings
  curl --proto '=https' --tlsv1.2 -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  got="$(gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | awk -F: '$1=="fpr"{print $10; exit}')"
  [[ "$got" == "$docker_fpr" ]] || die "Docker's apt key has fingerprint $got, expected $docker_fpr"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    >/etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin
  systemctl enable --now docker
fi
if [[ "$skip_system" != 1 ]]; then
  command -v jq >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq jq gnupg curl; }
fi

# --- the bundle: signature, checksum, unpack -----------------------------------
marker="$root/.bundle-version"
if [[ "$(cat "$marker" 2>/dev/null || true)" != "$LOAMS_VERSION" ]]; then
  say "downloading Loams $LOAMS_VERSION"
  dl="$(mktemp -d)"
  trap 'rm -rf "$dl"' EXIT
  base="$repo/v$LOAMS_VERSION"
  bundle="loams-compose-$LOAMS_VERSION.tar.gz"
  for f in "$bundle" SHA256SUMS SHA256SUMS.asc; do
    curl --proto "$proto" --tlsv1.2 -fsSL --retry 3 "$base/$f" -o "$dl/$f"
  done
  gnupghome="$dl/gnupg"; mkdir -m 700 "$gnupghome"
  GNUPGHOME="$gnupghome" gpg --batch --quiet --import "$keyfile"
  GNUPGHOME="$gnupghome" gpg --batch --status-fd 1 --verify "$dl/SHA256SUMS.asc" "$dl/SHA256SUMS" 2>/dev/null \
    | grep -q "^\[GNUPG:\] VALIDSIG $fpr " \
    || die "SHA256SUMS is not signed by the Loams release key $fpr"
  (cd "$dl" && grep -F " $bundle" SHA256SUMS | sha256sum -c --quiet -) \
    || die "$bundle does not match SHA256SUMS"
  mkdir -p "$root"
  # Keep the host's own .env and secrets across a re-run.
  if [[ -f "$stack/.env" ]]; then cp -p "$stack/.env" "$dl/.env.keep"; fi
  tar -xzf "$dl/$bundle" -C "$root" --strip-components=1
  [[ -f "$dl/.env.keep" ]] && cp -p "$dl/.env.keep" "$stack/.env"
  echo "$LOAMS_VERSION" >"$marker"
fi

# --- .env and secrets/engine.env: settings only --------------------------------
mkdir -p "$stack/secrets"
if [[ ! -f "$stack/.env" ]]; then
  install -m 600 "$stack/.env.example" "$stack/.env"
fi
chmod 600 "$stack/.env"
setkv() {
  local tmp; tmp="$(mktemp "$stack/.env.XXXXXX")"
  K="$1" V="$2" awk 'BEGIN{FS="="; k=ENVIRON["K"]; v=ENVIRON["V"]}
    $1==k{print k "=" v; f=1; next} {print} END{if(!f) print k "=" v}' "$stack/.env" >"$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$stack/.env"
}
while IFS='=' read -r k v; do
  case "$k" in TS_AUTHKEY|LOAMS_SETUP_TOKEN) continue ;; esac
  setkv "$k" "$v"
done < <(env_values)
install -m 600 /dev/null "$stack/secrets/engine.env"
engine_env >"$stack/secrets/engine.env"
touch "$stack/secrets/api-keys"; chmod 600 "$stack/secrets/api-keys"
# The engine reads secrets/api-keys as uid 10001 (release/README.md).
chown 10001 "$stack/secrets/api-keys" 2>/dev/null || true

if [[ "$skip_system" == 1 ]]; then
  say "done (no system steps): $stack"
  exit 0
fi

# --- the service -------------------------------------------------------------------
systemctl daemon-reload
systemctl enable loams-byoc.service
systemctl restart loams-byoc.service
say "done: the engine joins your tailnet as ${TS_HOSTNAME:-loams}; check with: journalctl -u loams-byoc"
