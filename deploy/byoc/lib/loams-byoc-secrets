#!/usr/bin/env bash
# Reads the install's secrets from the cloud's secret store with the VM's own
# identity and writes them where the stack reads them. No cloud CLI, no key:
#
#   aws    IMDSv2 role credentials, then Secrets Manager with SigV4 (curl)
#   gcp    the metadata server's service-account token, then Secret Manager
#   azure  IMDS managed-identity token for Key Vault, then the vault's REST API
#
# Secret names (the prefix is SECRET_PREFIX in /etc/loams-byoc/config.env):
#   <prefix>/tailnet-authkey   required   -> TS_AUTHKEY in .env
#   <prefix>/setup-token       required   -> LOAMS_SETUP_TOKEN in .env
#   <prefix>/api-keys          optional   -> secrets/api-keys
# On AWS the separator is "/"; Google Cloud and Azure names cannot hold "/",
# so they use "-" (the prefix "loams-<install>" gives loams-<install>-setup-token).
#
# Never prints a secret value. A failure names the secret and the HTTP status.
#
#   loams-byoc-secrets [aws|gcp|azure]     (default: LOAMS_BYOC_CLOUD from the config)
set -euo pipefail
umask 077

config="${LOAMS_BYOC_CONFIG:-/etc/loams-byoc/config.env}"
# shellcheck disable=SC1090
[[ -r "$config" ]] && . "$config"
cloud="${1:-${LOAMS_BYOC_CLOUD:-}}"
stack="${LOAMS_BYOC_STACK:-/opt/loams/release}"
prefix="${SECRET_PREFIX:-}"
[[ -n "$prefix" ]] || { echo "loams-byoc-secrets: SECRET_PREFIX is not set" >&2; exit 2; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

die() { echo "loams-byoc-secrets: $*" >&2; exit 1; }

# curl wrapper: body to $work/body, prints the HTTP status. A transport error
# prints 000. Headers (which carry tokens) are passed in a file, not argv.
http() {
  local out
  out="$(curl --silent --show-error --proto '=http,https' --max-time 20 \
    --retry 3 --retry-connrefused --retry-delay 2 \
    --output "$work/body" --write-out '%{http_code}' "$@" 2>"$work/curl.err")" || out=000
  printf '%s' "$out"
}

secret_name() {  # $1 = short name
  case "$cloud" in
    aws) printf '%s/%s' "$prefix" "$1" ;;
    *) printf '%s-%s' "${prefix//\//-}" "$1" ;;
  esac
}

# --- aws ------------------------------------------------------------------
aws_creds_ready=0
aws_prepare() {
  ((aws_creds_ready)) && return 0
  local imds="${LOAMS_BYOC_IMDS_URL:-http://169.254.169.254}" code token role
  : "${REGION:?REGION is not set}"
  code="$(http -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' "$imds/latest/api/token")"
  [[ "$code" == 200 ]] || die "IMDSv2 did not answer ($code); is the instance metadata service on, with hop limit 2 for containers?"
  token="$(cat "$work/body")"
  code="$(http -H "X-aws-ec2-metadata-token: $token" "$imds/latest/meta-data/iam/security-credentials/")"
  [[ "$code" == 200 ]] || die "the instance has no IAM role ($code)"
  role="$(head -n1 "$work/body")"
  code="$(http -H "X-aws-ec2-metadata-token: $token" "$imds/latest/meta-data/iam/security-credentials/$role")"
  [[ "$code" == 200 ]] || die "could not read the role's credentials ($code)"
  aws_ak="$(jq -er .AccessKeyId "$work/body")"
  aws_sk="$(jq -er .SecretAccessKey "$work/body")"
  aws_st="$(jq -er .Token "$work/body")"
  aws_creds_ready=1
}

aws_get() {  # $1 = full secret id; body -> $work/value; prints status
  aws_prepare
  local endpoint="${LOAMS_BYOC_SECRETS_URL:-https://secretsmanager.$REGION.amazonaws.com}" code
  printf 'x-amz-security-token: %s\n' "$aws_st" >"$work/hdr"
  printf 'user = "%s:%s"\n' "$aws_ak" "$aws_sk" >"$work/cfg"
  code="$(http -K "$work/cfg" -H "@$work/hdr" \
    --aws-sigv4 "aws:amz:$REGION:secretsmanager" \
    -H 'Content-Type: application/x-amz-json-1.1' -H 'X-Amz-Target: secretsmanager.GetSecretValue' \
    --data "$(jq -cn --arg id "$1" '{SecretId:$id}')" "$endpoint/")"
  if [[ "$code" == 200 ]]; then
    jq -er '.SecretString // empty' "$work/body" >"$work/value" || { echo 000; return; }
  elif jq -e '.__type | test("ResourceNotFoundException")' "$work/body" >/dev/null 2>&1; then
    code=404
  fi
  printf '%s' "$code"
}

# --- gcp ------------------------------------------------------------------
gcp_ready=0
gcp_prepare() {
  ((gcp_ready)) && return 0
  local md="${LOAMS_BYOC_METADATA_URL:-http://metadata.google.internal}" code
  code="$(http -H 'Metadata-Flavor: Google' "$md/computeMetadata/v1/instance/service-accounts/default/token")"
  [[ "$code" == 200 ]] || die "the metadata server gave no service-account token ($code)"
  printf 'Authorization: Bearer %s\n' "$(jq -er .access_token "$work/body")" >"$work/hdr"
  if [[ -z "${GCP_PROJECT:-}" ]]; then
    code="$(http -H 'Metadata-Flavor: Google' "$md/computeMetadata/v1/project/project-id")"
    [[ "$code" == 200 ]] || die "could not read the project id ($code)"
    GCP_PROJECT="$(cat "$work/body")"
  fi
  gcp_ready=1
}

gcp_get() {
  gcp_prepare
  local endpoint="${LOAMS_BYOC_SECRETS_URL:-https://secretmanager.googleapis.com}" code
  code="$(http -H "@$work/hdr" "$endpoint/v1/projects/$GCP_PROJECT/secrets/$1/versions/latest:access")"
  if [[ "$code" == 200 ]]; then
    jq -er '.payload.data // empty' "$work/body" | base64 -d >"$work/value" || { echo 000; return; }
  fi
  printf '%s' "$code"
}

# --- azure ----------------------------------------------------------------
azure_ready=0
azure_prepare() {
  ((azure_ready)) && return 0
  local imds="${LOAMS_BYOC_IMDS_URL:-http://169.254.169.254}" code url
  : "${AZURE_VAULT:?AZURE_VAULT is not set}"
  url="$imds/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net"
  [[ -z "${AZURE_CLIENT_ID:-}" ]] || url="$url&client_id=$AZURE_CLIENT_ID"
  code="$(http -H 'Metadata: true' "$url")"
  [[ "$code" == 200 ]] || die "IMDS gave no managed-identity token ($code); is an identity assigned to the VM?"
  printf 'Authorization: Bearer %s\n' "$(jq -er .access_token "$work/body")" >"$work/hdr"
  azure_ready=1
}

azure_get() {
  azure_prepare
  local base="${LOAMS_BYOC_SECRETS_URL:-https://$AZURE_VAULT.vault.azure.net}" code
  code="$(http -H "@$work/hdr" "$base/secrets/$1?api-version=7.4")"
  if [[ "$code" == 200 ]]; then
    jq -er '.value // empty' "$work/body" >"$work/value" || { echo 000; return; }
  fi
  printf '%s' "$code"
}

# --- shared -----------------------------------------------------------------
case "$cloud" in aws|gcp|azure) ;; *) die "usage: loams-byoc-secrets aws|gcp|azure" ;; esac

# fetch SHORT -> 0 found (value in $work/value), 1 not found; dies on other errors
fetch() {
  local name code
  name="$(secret_name "$1")"
  rm -f "$work/value"
  "${cloud}_prepare"   # in this shell, so a failure ends the script and the token is kept
  code="$("${cloud}_get" "$name")"
  case "$code" in
    200) [[ -s "$work/value" ]] || die "secret $name is empty"; return 0 ;;
    404) return 1 ;;
    *) die "reading secret $name failed (HTTP $code)" ;;
  esac
}

# set_env KEY from $work/value into .env, without putting the value in argv
set_env() {
  local envfile="$stack/.env" tmp
  [[ -f "$envfile" ]] || die "$envfile does not exist; run loams-byoc-bootstrap first"
  tmp="$(mktemp "$stack/.env.XXXXXX")"
  K="$1" V="$(tr -d '\r\n' <"$work/value")" awk '
    BEGIN { FS = "="; k = ENVIRON["K"]; v = ENVIRON["V"] }
    $1 == k { print k "=" v; found = 1; next }
    { print }
    END { if (!found) print k "=" v }' "$envfile" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$envfile"
  # install.sh --cloud runs this as root for the ssh user, who runs compose.
  [[ -z "${LOAMS_BYOC_OWNER:-}" || "$(id -u)" -ne 0 ]] || chown "$LOAMS_BYOC_OWNER" "$envfile"
}

fetch tailnet-authkey || die "missing secret $(secret_name tailnet-authkey) (the Tailscale auth key)"
set_env TS_AUTHKEY
fetch setup-token || die "missing secret $(secret_name setup-token) (the first-run setup token)"
set_env LOAMS_SETUP_TOKEN
mkdir -p "$stack/secrets"
if fetch api-keys; then
  install -m 600 "$work/value" "$stack/secrets/api-keys"
  # The engine reads it as uid 10001 (release/README.md).
  [[ "$(id -u)" -ne 0 ]] || chown 10001 "$stack/secrets/api-keys"
  echo "loams-byoc-secrets: wrote secrets/api-keys"
fi
echo "loams-byoc-secrets: ok ($cloud, prefix $prefix)"
