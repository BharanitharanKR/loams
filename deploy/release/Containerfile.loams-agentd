# syntax=docker/dockerfile:1.7
# The optional Loams agent daemon image (ghcr.io/ostrium-labs/loams-agentd).
# Built by build.sh from the repository root. The daemon reads its config from
# LOAMS_AGENTD_CONFIG; compose mounts one at /etc/loams-agentd/config.toml.
ARG RUST_IMAGE=docker.io/library/rust:1.97.1-slim-trixie
ARG RUNTIME_IMAGE=docker.io/library/debian:trixie-slim

FROM ${RUST_IMAGE} AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      protobuf-compiler libprotobuf-dev pkg-config libssl-dev clang g++ make cmake perl git \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_TOOLCHAIN=1.97.1 \
    CARGO_TERM_COLOR=never
WORKDIR /src
COPY . .
ARG CARGO_BUILD_JOBS=
RUN --mount=type=cache,id=loams-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=loams-target-agentd,target=/src/target \
    if [ -n "$CARGO_BUILD_JOBS" ]; then export CARGO_BUILD_JOBS; else unset CARGO_BUILD_JOBS; fi \
 && cargo build --locked --release -p loams-agentd --bin loams-agentd \
 && install -D -m 0755 target/release/loams-agentd /out/loams-agentd

FROM ${RUNTIME_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git openssh-client tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 loams \
 && useradd --system --uid 10001 --gid loams --create-home --home-dir /home/loams --shell /usr/sbin/nologin loams \
 && install -d -m 0700 -o loams -g loams /home/loams/agentd
COPY --from=build /out/loams-agentd /usr/local/bin/loams-agentd
LABEL org.opencontainers.image.title="loams-agentd" \
      org.opencontainers.image.description="Loams agent daemon (optional)" \
      org.opencontainers.image.source="https://github.com/ostrium-labs/loams" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
# The daemon keeps its token, lock, discovery file and store beside its
# config.toml, in a directory it makes owner-only, so that directory must be
# its own and writable: /home/loams/agentd (in the data volume). A deployment
# mounts its config.toml there read-only, and anything else it names (TLS
# files) under /etc/loams-agentd (SD1 Task 30).
ENV LOAMS_AGENTD_CONFIG=/home/loams/agentd/config.toml
USER 10001:10001
WORKDIR /home/loams
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/local/bin/loams-agentd", "status"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/loams-agentd"]
CMD ["run"]
