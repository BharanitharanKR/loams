# Loams stack settings. Copy to .env next to compose.yaml
# (byoc/install.sh writes it for you on a remote machine).

# --- Profiles -------------------------------------------------------------------
# Empty: the light default, for a laptop or one small VM. The engine on its
# embedded stores (metastore on openraft + redb, Live on redb, Durable on
# SQLite) with the bucket below, Loams House, Loams Postgres on local folders,
# agentd and the tailnet sidecar. One node and one disk: no replication, so
# back up the volumes.
# Add, comma-separated (here, not with --profile, so that the engine,
# `migrate` and `loams upgrade` see the same set):
#   tikv              PD, TiKV and TiDB: Loams SQL, and the engine's metastore
#                     and Live on TiKV, for scale. Several GB more of images
#                     and RAM. Choose it before the first start: the engine
#                     refuses to switch stores on existing data.
#   rustfs            RustFS, an S3 bucket for Loams Postgres's pageserver,
#                     safekeeper and endpoint storage instead of local folders.
#                     Also before the first start.
#   house-tailnet     the House's own tailnet node (HOUSE_TS_* below).
#   postgres-control  Loams Postgres's control plane (below).
#   console           the console served from this machine (below).
#   kafka             Kafka clients on 127.0.0.1:9093, preview (below).
# Example: COMPOSE_PROFILES=tikv,rustfs
COMPOSE_PROFILES=

# --- Images -----------------------------------------------------------------
LOAMS_REGISTRY=ghcr.io/ostrium-labs
# Pinned to a release so a stack is reproducible. `latest` is the rolling tag
# that follows the latest release. Upgrade with `loams upgrade`, not by editing this.
LOAMS_VERSION=0.1.1
# HOUSE_IMAGE and AGENTD_IMAGE, if set, replace the House's and agentd's
# images (the upgrade gate pins them to the previous release's).
# The `tikv` profile's images.
TIDB_IMAGE=ghcr.io/ostrium-labs/tidb:v8.5.8-loams.1
# amd64 only; arm64 hosts (Apple silicon) run it emulated.
TIDB_PLATFORM=linux/amd64
TIKV_TAG=v8.5.8
TAILSCALE_TAG=v1.90.6
HEADSCALE_TAG=0.26.1

# --- Kafka (`kafka` profile; preview, off by default) ------------------------------
# Ostrium's fork of Apache Iggy: its Kafka gateway in front of its own Iggy
# server, one image pinned by digest (the pair is tested together; Iggy's
# protocol is pre-1.0). Transactions and exactly-once are not supported.
# Not Loams' own data: the engine does not read Iggy yet (the Event Fabric
# bridge arrives with FL1). Do not edit the digest by hand: `loams upgrade`
# and the release notes move it.
IGGY_KAFKA_IMAGE=ghcr.io/ostrium-labs/iggy@sha256:649c20714dcde257131be46e456ab32bf62d283a047c26b41b3c8c3132cea332
# Iggy's root user, which the gateway signs in as. Set the password before
# the first start (`openssl rand -hex 24`): Iggy keeps it in its volume. The
# profile refuses to start while it is empty, this placeholder or shorter
# than 12 characters (config/kafka-guard.sh).
KAFKA_IGGY_USER=iggy
KAFKA_IGGY_PASSWORD=change-me
# The published Kafka port. Loopback by default; with anything else, turn SASL
# on and put the port behind your tailnet.
KAFKA_BIND=127.0.0.1
KAFKA_PORT=9093
# What clients are told to reconnect to (Kafka's advertised.listeners): the
# host they reach KAFKA_PORT on. A Kafka client on another machine needs that
# machine's tailnet name here.
KAFKA_ADVERTISED_HOST=127.0.0.1
# SASL/PLAIN against Iggy users (the user and password a client sends are an
# Iggy user's). Off: anyone who reaches the port can create and delete topics.
KAFKA_SASL_ENABLED=false
# Create a topic on first Metadata or produce to an unknown name.
KAFKA_AUTO_CREATE_TOPICS=false

# --- Tailnet (the only way in) ------------------------------------------------
# 0.1.1 supports your own Tailscale tailnet with the hosted console.
# An auth key from the Tailscale admin console. Empty: the sidecar logs a login
# URL instead.
TS_AUTHKEY=
# Empty for Tailscale (the default and the only supported setting). A Headscale
# URL is coming soon, unsupported in 0.1.1: Headscale issues no ts.net HTTPS
# certificates, so the hosted console cannot reach the engine through it.
TS_LOGIN_SERVER=
# The engine's node name: the console's LOAMS_ENGINE_URL becomes
# https://loams.<tailnet>.ts.net. Turn on MagicDNS and HTTPS certificates for
# the tailnet.
TS_HOSTNAME=loams
# https (Tailscale with HTTPS certificates). http is for Headscale
# (coming soon, unsupported in 0.1.1).
TS_SERVE_MODE=https
TS_EXTRA_ARGS=

# --- Headscale (`--profile headscale`, coming soon, unsupported in 0.1.1) ----
# The URL every tailnet client (this stack, your laptop) reaches Headscale at.
HEADSCALE_SERVER_URL=http://127.0.0.1:8090
HEADSCALE_BASE_DOMAIN=loams.internal
# 127.0.0.1 keeps it on this machine; 0.0.0.0 (behind TLS) lets other
# devices join.
HEADSCALE_BIND=127.0.0.1
HEADSCALE_PORT=8090

# --- Engine -------------------------------------------------------------------
# tailscale (default): the sidecar's `tailscale serve` proxy is the only way
#   in and adds Tailscale-User-Login headers, which the engine trusts only
#   from that local proxy.
# oidc: JWTs from LOAMS_OIDC_ISSUER, checked against its JWKS. Use an OIDC
#   issuer of your own: auth.loams.dev does not answer yet (its DNS name does
#   not resolve as of 2026-10-23). Zitadel there is planned (design 76, IA1),
#   and no release deploys it. Set
#     LOAMS_AUTH_MODE=oidc
#     LOAMS_OIDC_ISSUER=https://idp.example.com   (your issuer)
#     LOAMS_OIDC_AUDIENCE=loams-console   (the value your issuer puts in `aud`;
#       for Zitadel, the project id or the client id, settled in IA0)
#     LOAMS_OIDC_ALLOWED_EMAILS=you@example.com   (or _SUBJECTS / _GROUPS;
#       oidc mode refuses to start without one of them)
# apikey: hashed keys for the CLI and SDKs in secrets/api-keys
#   (LOAMS_API_KEYS_FILE), which the engine (gid 10001) must be able to read;
#   see "API keys" in README.md. Set LOAMS_AUTH_MODE=apikey.
# off: no auth, loopback only.
LOAMS_AUTH_MODE=tailscale
LOAMS_OIDC_ISSUER=https://auth.loams.dev
LOAMS_OIDC_AUDIENCE=loams-console
LOAMS_OIDC_ALLOWED_EMAILS=
# tailscale mode: the Tailscale logins admitted, comma-separated and
# case-insensitive (the Tailscale-User-Login value, e.g.
# alice@example.com,bob@github). Empty admits every tailnet user your ACLs let
# reach this node (the engine logs a warning).
LOAMS_TAILSCALE_ALLOWED_USERS=
# First-run setup with auth on (tailscale, oidc or apikey): the console's setup
# page (or AuthService/CompleteSetup) creates the org and its owner only when
# given this token. Without it, setup is refused. Generate one with
#   openssl rand -hex 32
# Setup runs once: after the org exists it is refused whatever the token, so
# you can empty this and restart the engine afterwards. Not needed with
# LOAMS_AUTH_MODE=off (setup is open on loopback). Set it here or in
# secrets/engine.env; when both set it, secrets/engine.env wins.
LOAMS_SETUP_TOKEN=
# Extra browser origins allowed to call the engine, comma-separated exact
# origins (https://host[:port]). Default: none. The console the engine serves at
# https://loams.<tailnet>/ui/ is same-origin, and Loams Desktop sends the
# engine's own origin, so neither needs an entry. Add one only for a console
# you serve from another origin (`--profile console`).
LOAMS_CORS_ORIGINS=
# The remote agentd hosts Studio in the console at /ui/ may call
# (`loams-agentd serve --remote`), exact origins such as
# https://agentd.<tailnet>.ts.net, separated by spaces or commas. They join
# connect-src in the console's Content-Security-Policy. Each host must list the
# console's origin (https://loams.<tailnet>.ts.net) in its --allow-origin.
LOAMS_AGENTD_ORIGINS=
# Where the engine keeps its data: file:///var/lib/loams/bucket (the loams-data
# volume), or s3://bucket/prefix (also gs://..., az://...) with the store's
# settings in secrets/engine.env, which the engine and `migrate` read:
#   AWS S3:        AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#                  (no keys on EC2/EKS: the instance or workload role)
#   Cloudflare R2: the above with AWS_REGION=auto and
#                  AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MinIO/RustFS:  the above with AWS_ENDPOINT_URL=http://<host>:9000 (path
#                  style; an http:// endpoint implies AWS_ALLOW_HTTP=true; set
#                  AWS_VIRTUAL_HOSTED_STYLE_REQUEST=true if the store needs it)
#   GCS:           GOOGLE_SERVICE_ACCOUNT_KEY=<the JSON key on one line>
#   Azure:         AZURE_STORAGE_ACCOUNT_NAME, AZURE_STORAGE_ACCOUNT_KEY
#                  (no key on an Azure VM with a managed identity:
#                  AZURE_CREDENTIAL_TYPE=managed_identity)
# See "The bucket" in docs/release/preview.md.
LOAMS_BUCKET=file:///var/lib/loams/bucket
# Loopback: Graph refuses any other address. Only the engine and the Tailscale
# sidecar share this network namespace; no other container may join it.
LOAMS_LISTEN=127.0.0.1:8080
# The listener that trusts Tailscale identity headers: a loopback port of its
# own, the target of the sidecar's `tailscale serve` (tailscale/serve-*.json)
# and nothing else.
LOAMS_TAILSCALE_LISTEN=127.0.0.1:7781
# Durable execution's store. Empty: SQLite in the loams-data volume (one
# engine). With the `tikv` profile, tikv://pd:2379/loams_durable puts it on
# TiKV for several engines: a fresh keyspace, nothing is copied from SQLite.
LOAMS_DURABLE_STORE=
RUST_LOG=info

# --- House ------------------------------------------------------------------------
# Loams House runs by default, reached through the engine (the console's House
# page). The `house-tailnet` profile also puts it on its own tailnet node,
# https://<HOUSE_TS_HOSTNAME>.<tailnet>.ts.net (ClickHouse HTTP; user
# `default`, password in house.key in the house-data volume). That sidecar is a
# second tailnet node: an auth key of its own, or empty to use TS_AUTHKEY
# (which must then be reusable).
HOUSE_TS_AUTHKEY=
HOUSE_TS_HOSTNAME=loams-house
# The workers' OS sandbox: pods (Landlock and seccomp; Linux 6.7 or later,
# works under Docker's default profile) or netns (adds a user and network
# namespace per worker; needs unprivileged user namespaces in the container,
# as Podman allows by default).
HOUSE_SANDBOX=pods
# Wire the engine to the House (loams.house.v1, the console's House page) over
# TLS on the house-link network (HS1 Task 20). Empty leaves loams.house.v1
# answering house_not_configured.
LOAMS_HOUSE_ENDPOINT=https://house:8443
# The Loams principals the engine may act for on the House, `principal=scopes`
# separated by `;` (scopes: read, write, ddl, admin joined by `+`). A principal
# not listed has no House access. Principals: tailscale:<login>,
# apikey:<id>, user:<oidc sub>, session:<id>, email:<address>.
# Example: tailscale:alice@example.com=read+write+ddl;apikey:ci=read
HOUSE_PRINCIPALS=

# --- Postgres -------------------------------------------------------------------
# The Loams Postgres (Neon) stack, included by default (its storage image is
# the largest of the stack, about 5 GB unpacked). ./postgres-off.yaml leaves it
# out. Its pageserver and safekeeper keep their remote storage in local folders
# in their volumes, or in RustFS with the `rustfs` profile.
LOAMS_POSTGRES_COMPOSE=../loams-postgres-dev/compose.yaml
# The tenant and timeline compute1 attaches to. Leave both empty: the one-shot
# pg-bootstrap service creates them on the first `up` and keeps their ids in the
# pg-bootstrap volume, and compute1 starts after it. Set both (32 hex characters
# each) to use your own; pg-bootstrap then only makes sure they exist (see
# deploy/loams-postgres-dev/README.md).
TENANT_ID=
TIMELINE_ID=

# --- Postgres control plane (`--profile postgres-control`) ----------------------
# pg-control provisions projects, branches and computes on the Postgres stack
# above. Only pg-runner gets a container runtime's socket. Prefer rootless
# Podman's ($XDG_RUNTIME_DIR/podman/podman.sock, `systemctl --user enable
# --now podman.socket`): whatever holds the socket can do what its owner can.
# Rootful Docker's /var/run/docker.sock is root on this machine.
CONTAINER_SOCKET=/var/run/docker.sock
# The socket's group id (`stat -c %g <socket>`): 0 for rootless Podman, the
# docker group's id for rootful Docker.
CONTAINER_SOCKET_GID=0
# loams.postgres.v1, with the API keys in secrets/pg-api-keys.json.
PG_CONTROL_BIND=127.0.0.1
PG_CONTROL_PORT=7680
# Where each endpoint's port (55500-55999) is published on this machine.
PG_ENDPOINT_BIND=127.0.0.1
# The stack's network the computes join: <compose project>_default.
PG_COMPUTE_NETWORK=loams_default

# --- Console (`--profile console`; optional) ----------------------------------------
# The engine serves the console at https://loams.<tailnet>/ui/; set these only
# to serve a console you build yourself from another origin, and add that
# origin to LOAMS_CORS_ORIGINS.
LOAMS_ENGINE_URL=https://loams.example-tailnet.ts.net
LOAMS_AUTH_ISSUER=https://auth.loams.dev
LOAMS_AUTH_CLIENT_ID=loams-console
LOAMS_CONSOLE_DIR=./console/dist
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=3000

# Upgrades (design §54 §7.3): where `loams upgrade` keeps its snapshots. Empty
# uses the `upgrade-snapshots` volume; a host path (mode 0700, on this
# machine) keeps them there instead. Snapshots hold secrets and are never
# uploaded.
LOAMS_UPGRADE_SNAPSHOT_DIR=
