# syntax=docker/dockerfile:1.7
# The Loams engine image (ghcr.io/ostrium-labs/loams), built by build.sh from
# the repository root. Multi-stage: the console stage builds the web console
# (web/apps/console, base /ui/), the build stage compiles `loams` with the
# release feature set (FEATURES below), the runtime stage is debian-slim with
# the binary, the console under /usr/share/loams/console (which the engine
# serves at /ui/, same-origin with its API), curl for the healthcheck and tini
# as PID 1, run as an unprivileged user.
ARG RUST_IMAGE=docker.io/library/rust:1.97.1-slim-trixie
ARG RUNTIME_IMAGE=docker.io/library/debian:trixie-slim
ARG NODE_IMAGE=docker.io/library/node:22.23.2-trixie-slim

# The console ships with every deployment (owner, 2026-10-23): built here from
# the same commit, so an image never carries a console from another release.
# Only the console and the workspace packages it depends on are installed.
FROM ${NODE_IMAGE} AS console
ENV CI=1 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /src
COPY . .
RUN corepack enable \
 && pnpm install --frozen-lockfile --filter "@loams/console..." \
 && cd web \
 && LOAMS_UI_BASE=/ui/ pnpm build \
 && test -f apps/console/dist/index.html \
 && grep -q '/ui/assets/' apps/console/dist/index.html \
 && cp -a apps/console/dist /out

FROM ${RUST_IMAGE} AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      protobuf-compiler libprotobuf-dev pkg-config libssl-dev clang g++ make cmake perl git \
 && rm -rf /var/lib/apt/lists/*
# The image's toolchain, not rust-toolchain.toml's (which also asks for
# rustfmt and clippy, which a release build does not need).
ENV RUSTUP_TOOLCHAIN=1.97.1 \
    CARGO_TERM_COLOR=never
WORKDIR /src
COPY . .
ARG FEATURES=live,live-tikv,durable,durable-tikv,graph,git,tikv,pgwire,mysql-wire,stream-grpc
ARG CARGO_BUILD_JOBS=
RUN --mount=type=cache,id=loams-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=loams-target-engine,target=/src/target \
    if [ -n "$CARGO_BUILD_JOBS" ]; then export CARGO_BUILD_JOBS; else unset CARGO_BUILD_JOBS; fi \
 && cargo build --locked --release -p loams --bin loams --features "$FEATURES" \
 && install -D -m 0755 target/release/loams /out/loams

FROM ${RUNTIME_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
# `migrate` also mounts the House's, pg-control's and the snapshots' volumes
# (design §54 §6.4, §7.3): a volume first mounted by this image takes the
# owners of these directories, so the House and pg-control (the same uid)
# still own theirs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 loams \
 && useradd --system --uid 10001 --gid loams --home-dir /var/lib/loams --shell /usr/sbin/nologin loams \
 && install -d -o loams -g loams -m 0750 /var/lib/loams /var/lib/loams/bucket /var/lib/loams/graph \
 && install -d -o loams -g loams -m 0750 /var/lib/loams-house \
 && install -d -o loams -g loams -m 0700 /var/lib/loams-pg-control /var/lib/loams-upgrade-snapshots
COPY --from=build /out/loams /usr/local/bin/loams
COPY --from=console --chmod=a=rX /out /usr/share/loams/console
LABEL org.opencontainers.image.title="loams" \
      org.opencontainers.image.description="Loams engine" \
      org.opencontainers.image.source="https://github.com/ostrium-labs/loams" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 10001:10001
WORKDIR /var/lib/loams
VOLUME ["/var/lib/loams"]
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/loams"]
CMD ["standalone", "--bucket", "file:///var/lib/loams/bucket", "--data-dir", "/var/lib/loams", \
     "--listen", "127.0.0.1:8080", "--graph-data-dir", "/var/lib/loams/graph"]
