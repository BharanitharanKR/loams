# Passes LOAMS_SETUP_TOKEN from .env to the engine (compose interpolates
# env_file values from .env and the shell). It is an env_file rather than an
# `environment:` entry so that a LOAMS_SETUP_TOKEN in secrets/engine.env,
# read after this file, still works. Set the token in .env or in
# secrets/engine.env, not here.
LOAMS_SETUP_TOKEN=${LOAMS_SETUP_TOKEN:-}
