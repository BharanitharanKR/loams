{
	email {$ACME_EMAIL}
}

{$AUTH_DOMAIN} {
	# The issuer is global (https://{$AUTH_DOMAIN}/, blueprints/loams-console.yaml),
	# so its discovery document must live at the root, where OIDC clients
	# (the console, the engine) look for it. Authentik serves it per
	# application; every application shares the global issuer and the
	# signing key, so the console's document is the issuer's.
	rewrite /.well-known/openid-configuration /application/o/loams-console/.well-known/openid-configuration

	reverse_proxy server:9000

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
