# The hosted auth service (deploy/release/auth/README.md).

# The public host name; Caddy gets its certificate from Let's Encrypt.
AUTH_DOMAIN=auth.loams.dev
ACME_EMAIL=ops@loams.dev

# The console's origin: its redirect URI is <origin>/ (exact match).
LOAMS_CONSOLE_ORIGIN=https://console.loams.dev

# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=
# Generate with: openssl rand -base64 36 | tr -d '\n'
PG_PASS=

# First start only: the akadmin account (remove after the first login).
AUTHENTIK_BOOTSTRAP_EMAIL=ops@loams.dev
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Outgoing mail for enrollment verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=Loams <no-reply@loams.dev>

# Authentik's version (design §38 D447).
AUTHENTIK_TAG=2026.8.3
