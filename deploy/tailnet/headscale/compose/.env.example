# Copy to .env (chmod 600). Never commit .env.

# --- Names and addresses -----------------------------------------------------
HEADSCALE_HOST=headscale.loams.dev
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=
# The host's public addresses (embedded DERP advertises them to clients).
PUBLIC_IPV4=
PUBLIC_IPV6=
# The host's own tailnet address, once it has joined (docs/platform/deploy/headscale.md
# step 7). 127.0.0.1 until then: the management API is then reachable only on
# the host itself.
ADMIN_BIND=127.0.0.1

# --- Authentik OIDC client -----------------------------------------------------
# Same value as HEADSCALE_OIDC_CLIENT_SECRET in the Authentik compose .env
# (read by loams-05-headscale.yaml). openssl rand -hex 32
HEADSCALE_OIDC_CLIENT_SECRET=

# --- Backups: nightly encrypted copy of db, keys and policy to S3 --------------
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=headscale
BACKUP_AT=03:40
BACKUP_RETENTION_DAYS=30
# Public key of the offline backup key: age-keygen -o headscale-backup.key
# (keep the private file offline, never on this host); put the "age1..." line here.
BACKUP_AGE_RECIPIENT=
BACKUP_HEARTBEAT_URL=
