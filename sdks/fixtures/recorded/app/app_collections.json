    {
      "about": "Upsert the five notes, keyed (R3).",
      "call": "documents.write",
      "request": {
        "method": "POST",
        "path": "/loams.collection.v1.DocumentService/WriteDocuments",
        "headers": {
          "content-type": "application/json"
        },
        "body": "{\"namespace\":\"app\",\"collection\":\"notes\",\"ops\":[{\"upsert\":{\"id\":{\"uint\":\"1\"},\"source\":{\"title\":\"Refund policy\",\"body\":\"refund policy for every order\",\"tags\":\"policy\",\"n\":1},\"vectors\":{\"embedding\":[1,0,0,0]}}},{\"upsert\":{\"id\":{\"uint\":\"2\"},\"source\":{\"title\":\"Shipping times\",\"body\":\"shipping takes three days\",\"tags\":\"shipping\",\"n\":2},\"vectors\":{\"embedding\":[0.9,0.1,0,0]}}},{\"upsert\":{\"id\":{\"uint\":\"3\"},\"source\":{\"title\":\"Refund window\",\"body\":\"the refund window is thirty days\",\"tags\":\"policy\",\"n\":3},\"vectors\":{\"embedding\":[0,0,1,0]}}},{\"upsert\":{\"id\":{\"uint\":\"4\"},\"source\":{\"title\":\"Returns\",\"body\":\"returns need a receipt before a refund\",\"tags\":\"policy\",\"n\":4},\"vectors\":{\"embedding\":[0.5,0.5,0,0]}}},{\"upsert\":{\"id\":{\"uint\":\"5\"},\"source\":{\"title\":\"Gift cards\",\"body\":\"gift cards never expire\",\"tags\":\"billing\",\"n\":5},\"vectors\":{\"embedding\":[0,0,0,1]}}}],\"idempotencyKey\":\"app-upsert-1\"}"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "loams-consistency-token": "v1:s1/p0@2,s1/p1@2,s1/p3@1"
        },
        "body": {
