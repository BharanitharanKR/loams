{
  "about": "The consistency token corpus (SDKP P0d, runtime contract R4). The encoding is crates/loams-collection/src/token.rs: `v1:` then `s<stream>/p<partition>@<offset>` items joined by `,`, every number canonical decimal. Every SDK's `<lang>_consistency_token_merge` runs this file; `parse` cases must print back exactly, `merge` is the max offset per (stream, partition), normalised (sorted by stream then partition, one item per pair), and every `malformed` string is refused client-side with `invalid_argument`. Offsets and streams are u64 and partitions u32, so the maxima below must survive without rounding.",
  "parse": [
    { "name": "one_item", "text": "v1:s7/p3@918274", "items": [["7", 3, "918274"]] },
    { "name": "two_items_in_order", "text": "v1:s0/p0@0,s7/p3@918274", "items": [["0", 0, "0"], ["7", 3, "918274"]] },
    { "name": "empty", "text": "v1:", "items": [] },
    { "name": "maxima", "text": "v1:s18446744073709551615/p4294967295@18446744073709551615", "items": [["18446744073709551615", 4294967295, "18446744073709551615"]] },
    { "name": "order_is_kept", "text": "v1:s2/p0@1,s1/p5@3", "items": [["2", 0, "1"], ["1", 5, "3"]] }
  ],
  "merge": [
    { "name": "disjoint_partitions", "a": "v1:s1/p0@5", "b": "v1:s1/p1@2", "expect": "v1:s1/p0@5,s1/p1@2" },
    { "name": "same_partition_keeps_max", "a": "v1:s7/p3@10,s1/p0@5", "b": "v1:s7/p3@4,s7/p1@2,s1/p0@9", "expect": "v1:s1/p0@9,s7/p1@2,s7/p3@10" },
    { "name": "same_partition_larger_on_the_right", "a": "v1:s3/p0@1", "b": "v1:s3/p0@8", "expect": "v1:s3/p0@8" },
    { "name": "normalisation_order", "a": "v1:s2/p0@1,s1/p5@3", "b": "v1:s2/p0@8,s1/p5@2", "expect": "v1:s1/p5@3,s2/p0@8" },
    { "name": "empty_with_empty", "a": "v1:", "b": "v1:", "expect": "v1:" },
    { "name": "empty_is_identity", "a": "v1:", "b": "v1:s4/p2@6", "expect": "v1:s4/p2@6" },
    { "name": "u64_offsets_do_not_round", "a": "v1:s1/p0@9007199254740993", "b": "v1:s1/p0@9007199254740992", "expect": "v1:s1/p0@9007199254740993" }
  ],
  "malformed": [
    "v2:s1/p0@1",
    "v1:s1/p0",
    "v1:s01/p0@1",
    "v1:s1/p0@1,",
    "",
    "v1",
    "s1/p0@1",
    "v1:,s1/p0@1",
    "v1:s1/p00@1",
    "v1:s1/p0@01",
    "v1:s1/p4294967296@1",
    "v1:s18446744073709551616/p0@1",
    "v1:s+1/p0@1",
    "v1:s1/p0@-1",
    "v1:s1p0@1",
    "v1:S1/P0@1",
    "v1: s1/p0@1",
    "v1:s1/p0@1@2",
    "v1:s/p0@1"
  ]
}
