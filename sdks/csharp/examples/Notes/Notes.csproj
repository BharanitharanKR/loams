<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The "Build an app" example (SDKP L5 part D): the notes app scenario of
    sdks/fixtures/app-scenario.md through the public facade. CI builds it with the
    solution; running it needs a server:

        LOAMS_ENDPOINT=http://127.0.0.1:8080 LOAMS_NAMESPACE=notes-demo dotnet run (in examples/Notes)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Loams/Loams.csproj" />
  </ItemGroup>

</Project>
