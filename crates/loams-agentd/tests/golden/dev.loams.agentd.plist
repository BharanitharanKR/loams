<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by `loams-agentd service install`; it is rewritten on every install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.loams.agentd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/r&amp;d 50% $x &lt;y&gt;/Library/Application Support/Loams Desktop/agentd/runtime/current/loams-agentd</string>
    <string>run</string>
    <string>--service</string>
    <string>--config</string>
    <string>/Users/r&amp;d 50% $x &lt;y&gt;/Library/Application Support/Loams Desktop/agentd/config.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/r&amp;d 50% $x &lt;y&gt;/Library/Application Support/Loams Desktop/agentd/logs/agentd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/r&amp;d 50% $x &lt;y&gt;/Library/Application Support/Loams Desktop/agentd/logs/agentd.stdout.log</string>
</dict>
</plist>
