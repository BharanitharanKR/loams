{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "loams-pg-control"
    },
    "name": "loams-pg-control",
    "namespace": "loams-pg-acme"
  },
  "rules": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods"
      ],
      "verbs": [
        "get",
        "list",
        "watch",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "pods/resize"
      ],
      "verbs": [
        "patch"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "services"
      ],
      "verbs": [
        "get",
        "list",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "secrets"
      ],
      "verbs": [
        "get",
        "create",
        "patch",
        "delete"
      ]
    },
    {
      "apiGroups": [
        "metrics.k8s.io"
      ],
      "resources": [
        "pods"
      ],
      "verbs": [
        "get"
      ]
    }
  ]
}
