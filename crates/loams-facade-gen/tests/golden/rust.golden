 /// The call's name, in `snake_case`.
pub name: &'static str,
 /// The name `FacadeOptions` gave it, in `snake_case`.
pub proto_name: &'static str,
 /// The method that backs the call.
pub method: &'static str,
 /// The RPC, as `package.Service/Method`, which is the path curl and
 /// grpcurl use.
pub rpc: &'static str,
 /// The service that declares the method, fully qualified.
pub service: &'static str,
 /// The proto package the service is declared in.
pub package: &'static str,
 /// Whether the request message declares an `idempotency_key` field,
 /// read out of the descriptor. A keyed call may be retried, because a
 /// repeat returns the first call's recorded result rather than doing
 /// the work twice (R3, D610).
pub keyed: bool,
 /// What the proto says about repeating the call, as
 /// `FacadeOptions.idempotency_level` recorded it.
pub idempotency: Idempotency,
 /// Whether the SDK retries this call on its own, as
 /// `FacadeOptions.retry_safe` recorded it. Distinct from
 /// [`CallBinding::idempotency`]: a proto may declare a call
 /// idempotent and still ask for no automatic retry.
pub retry: Retry,
 /// Whether the call streams server messages.
pub streaming: Streaming,
 /// The paging fields, when `FacadeOptions.pagination` declared any.
pub pagination: Option<Pagination>,
}

/// One SDK module and its calls.
