// NewServiceClient builds the Connect client for a service, by fully
// qualified name, and returns it as the generated <Service>Client interface.
// It returns nil for a service this SDK does not speak.
func NewServiceClient(name string, httpClient connect.HTTPClient, baseURL string, opts ...connect.ClientOption) any {
	switch name {
	case "loams.instance.v1.InstanceService":
		return instancev1connect.NewInstanceServiceClient(httpClient, baseURL, opts...)

	case "loams.live.v1.LiveService":
		return livev1connect.NewLiveServiceClient(httpClient, baseURL, opts...)

	default:
		return nil
	}
}
