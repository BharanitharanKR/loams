// Pagination is AIP-158 paging, named by FacadeOptions.pagination.
type Pagination struct {
	// Items is the repeated field the iterator yields.
	Items string
	// NextPageToken goes in on the next call and comes out on this one.
	NextPageToken string
}

// CallBinding is one facade call, as the runtime dispatches it.
type CallBinding struct {
	// Module is the module the call is exposed on.
	Module string
	// Name is the call's name in Go case.
	Name string
	// ProtoName is the name FacadeOptions gave it, in snake_case.
	ProtoName string
	// Method is the method that backs the call.
	Method string
	// RPC is the RPC as package.Service/Method, which is the path curl and
	// grpcurl use.
	RPC     string
	Service string
	Package string
	// Idempotency, Retry and Streaming come from the proto, not from a guess.
	Idempotency Idempotency
	Retry       Retry
	Streaming   Streaming
	Pagination  *Pagination
}

// ModuleBinding is one SDK module and its calls.
type ModuleBinding struct {
	Name    string
	Summary string
	Service string
	Package string
	// Unstable reports that the package's wire contract may still change.
	Unstable bool
	// Derived is true for a second facade name for the same RPCs, which
	// has no summary of its own.
	Derived bool
	Calls   []CallBinding
}

