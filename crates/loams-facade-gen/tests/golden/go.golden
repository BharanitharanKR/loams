// NewServiceClient builds the Connect client for a service, by fully
// qualified name, and returns it as the generated <Service>Client interface.
// It returns nil for a service this SDK does not speak.
func NewServiceClient(name string, httpClient connect.HTTPClient, baseURL string, opts ...connect.ClientOption) any {
	switch name {
	case "loams.admin.v1.AgentService":
		return adminv1connect.NewAgentServiceClient(httpClient, baseURL, opts...)

	case "loams.admin.v1.AuditService":
		return adminv1connect.NewAuditServiceClient(httpClient, baseURL, opts...)

	case "loams.admin.v1.KeyService":
		return adminv1connect.NewKeyServiceClient(httpClient, baseURL, opts...)

	case "loams.admin.v1.OrgService":
		return adminv1connect.NewOrgServiceClient(httpClient, baseURL, opts...)

	case "loams.admin.v1.ProjectService":
		return adminv1connect.NewProjectServiceClient(httpClient, baseURL, opts...)

	case "loams.auth.v1.AuthService":
		return authv1connect.NewAuthServiceClient(httpClient, baseURL, opts...)

	case "loams.collection.v1.CollectionService":
		return collectionv1connect.NewCollectionServiceClient(httpClient, baseURL, opts...)

	case "loams.collection.v1.DocumentService":
		return collectionv1connect.NewDocumentServiceClient(httpClient, baseURL, opts...)

	case "loams.collection.v1.NamespaceService":
		return collectionv1connect.NewNamespaceServiceClient(httpClient, baseURL, opts...)

	case "loams.collection.v1.QueryService":
		return collectionv1connect.NewQueryServiceClient(httpClient, baseURL, opts...)

	case "loams.graph.v1.GraphAdminService":
		return graphv1connect.NewGraphAdminServiceClient(httpClient, baseURL, opts...)

	case "loams.instance.v1.InstanceService":
		return instancev1connect.NewInstanceServiceClient(httpClient, baseURL, opts...)

	case "loams.live.v1.LiveAdminService":
		return livev1connect.NewLiveAdminServiceClient(httpClient, baseURL, opts...)

	case "loams.live.v1.LiveService":
		return livev1connect.NewLiveServiceClient(httpClient, baseURL, opts...)

	case "loams.sql.v1.SqlService":
		return sqlv1connect.NewSqlServiceClient(httpClient, baseURL, opts...)

	case "loams.stream.v1.StreamService":
		return streamv1connect.NewStreamServiceClient(httpClient, baseURL, opts...)

	default:
		return nil
	}
}
